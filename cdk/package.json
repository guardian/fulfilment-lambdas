{
	"name": "cdk",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"test": "sh -c 'jest ${1:+--testPathPattern=\"$1\"}' --",
		"test-update": "sh -c 'jest -u ${1:+--testPathPattern=\"$1\"}' --",
		"check-formatting": "prettier --check **.ts",
		"lint": "eslint --cache --cache-location /tmp/eslintcache/ 'lib/**' 'bin/**'",
		"synth": "cdk synth --path-metadata false --version-reporting false",
		"diff": "cdk diff --path-metadata false --version-reporting false",
		"package": "sh -c 'pnpm type-check && pnpm lint && pnpm check-formatting && pnpm test $1 && pnpm synth' --",
		"fix-formatting": "prettier --write **.ts"
	},
	"devDependencies": {
		"@guardian/cdk": "61.11.1",
		"@guardian/eslint-config": "^11.0.0",
		"@guardian/prettier": "^8.0.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.14",
		"aws-cdk": "2.1014.0",
		"aws-cdk-lib": "2.260.0",
		"constructs": "10.4.2",
		"eslint": "^9.38.0",
		"globals": "^16.4.0",
		"jest": "^29.7.0",
		"prettier": "^3.3.3",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.4.6",
		"tsx": "^4.21.0",
		"typescript": "^5.6.3"
	},
	"jest": {
		"testMatch": [
			"<rootDir>/lib/**/*.test.ts"
		],
		"transform": {
			"^.+\\.tsx?$": "ts-jest"
		},
		"setupFilesAfterEnv": [
			"./jest.setup.js"
		]
	}
}

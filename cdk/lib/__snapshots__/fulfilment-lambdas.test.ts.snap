    "GuardianWeeklyDataQualityCompositeAlarm": {
      "Properties": {
        "ActionsEnabled": true,
        "AlarmActions": [
          {
            "Fn::Join": [
              "",
              [
                "arn:aws:sns:eu-west-1:",
                {
                  "Ref": "AWS::AccountId",
                },
                ":alarms-handler-topic-CODE",
              ],
            ],
          },
        ],
        "AlarmDescription": "Guardian Weekly fulfilment data has quality issues that may prevent newspaper delivery. Check the ValidationError metrics and the exporter logs. Follow the process in https://docs.google.com/document/d/1_3El3cly9d7u_jPgTcRjLxmdG2e919zCLvmcFCLOYAk/edit",
        "AlarmName": "URGENT 9-5 - CODE Guardian Weekly Data Quality Issues Detected",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "m1+m2+m3+m4",
            "Id": "expr_1",
            "Label": "Total Data Quality Errors",
            "ReturnData": true,
          },
          {
            "Id": "m1",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ErrorType",
                    "Value": "MissingAddress",
